# Dockerfile.public
# NOTE: The private monorepo (scaffold) is the single source of truth for this file.
# Always make modifications here in the private repo, then run `./scripts/sync_public.sh` to sync updates to scaffold_public.
#
# Public base image containing all Python dependencies (via uv) and Node.js 26.
# This image is intended to be published publicly (e.g. to ghcr.io) and can be used as the base for a private image that only adds your source code.

FROM python:3.14-slim AS base

# Install OS build tools and runtime dependencies required by the Scaffold monorepo (Python & Node)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        libffi-dev \
        libssl-dev \
        ca-certificates \
        curl \
        gnupg \
        # Version control tools – needed for git‑based Python deps
        git \
        openssh-client \
        # PostgreSQL client libraries (runtime for psycopg) and dev headers for building wheels
        postgresql-client libpq-dev \
        # Sodium library for argon2‑cffi
        libsodium-dev \
    && curl -fsSL https://deb.nodesource.com/setup_26.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install uv (the Python package manager)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

# Install just (task runner) for development convenience
RUN curl -LsSf https://github.com/casey/just/releases/download/1.28.0/just-1.28.0-x86_64-unknown-linux-musl.tar.gz \
    | tar -xz -C /usr/local/bin just

# Copy the package.json for the web app (used for npm install)
COPY apps/web/package.json ./apps/web/package.json
COPY apps/web/package-lock.json ./apps/web/package-lock.json

# Install Node dependencies (including dev) using npm ci
RUN npm ci --prefix apps/web

# Copy only the pyproject and lock files to leverage Docker layer caching.
COPY pyproject.toml uv.lock ./

# Install production dependencies (no dev groups) in a fully locked, reproducible manner.
RUN uv sync --no-dev --frozen --no-install-project

# The resulting image contains a ready‑to‑use Python environment with all required packages.
# It does NOT contain any of your application source code – that will be added in the private image.
